ENVIRONMENT=production
PROJECT_NAME="WELLWATCH PREVENT"
# In production, inject SECRET_KEY from secure secret manager (e.g. AWS Secrets Manager, HashiCorp Vault)
DATABASE_URL=postgresql://wellwatch_user:${DB_PASSWORD}@postgres:5432/wellwatch_prevent
BACKEND_CORS_ORIGINS=["https://prevent.wellwatch.ae"]
RATE_LIMIT_PER_MINUTE=60
