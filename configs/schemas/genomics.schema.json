{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "GenomicActionabilityRegistry",
  "description": "Validated schema for actionable genomic secondary findings and preventive surveillance pathways.",
  "type": "object",
  "required": ["version", "effective_date", "authoritative_body", "actionable_genes"],
  "properties": {
    "version": { "type": "string" },
    "effective_date": { "type": "string", "format": "date" },
    "authoritative_body": { "type": "string" },
    "actionable_genes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["gene_symbol", "associated_condition", "inheritance", "preventive_pathway", "clinical_guidance", "required_classification", "evidence_source"],
        "properties": {
          "gene_symbol": { "type": "string" },
          "associated_condition": { "type": "string" },
          "inheritance": { "type": "string", "enum": ["Autosomal Dominant", "Autosomal Recessive", "X-Linked"] },
          "preventive_pathway": { "type": "string" },
          "clinical_guidance": { "type": "string" },
          "required_classification": {
            "type": "array",
            "items": { "type": "string", "enum": ["PATHOGENIC", "LIKELY_PATHOGENIC"] }
          },
          "evidence_source": { "type": "string" }
        }
      }
    }
  }
}
