{
  "pathway_id": "DOH-PEDIATRIC-WELLCHILD-V1",
  "name": "Abu Dhabi Pediatric Well-Child Healthcare Pathway",
  "version": "1.2.0",
  "population": "PEDIATRIC",
  "publishing_authority": "Department of Health Abu Dhabi (DoH) & Abu Dhabi Public Health Centre (ADPHC)",
  "guideline_reference": "ADPHC Well-Child Clinical Guidelines & Child Health Screening Standards",
  "effective_date": "2024-01-01",
  "status": "ACTIVE",
  "eligibility_criteria": {
    "min_age_months": 0,
    "max_age_months": 72,
    "gender": "ALL",
    "coverage_requirement": "ALL_CHILDREN_IN_ABU_DHABI"
  },
  "milestones": [
    {
      "milestone_id": "WC-00M",
      "name": "Newborn Hospital Assessment",
      "target_window": { "target_age_months": 0, "min_age_months": 0, "max_age_months": 1 },
      "required_components": ["Newborn Metabolic Screening", "Hearing Screen", "Critical Congenital Heart Defect", "Physical Exam"]
    },
    {
      "milestone_id": "WC-02M",
      "name": "2-Month Well-Child Visit",
      "target_window": { "target_age_months": 2, "min_age_months": 1, "max_age_months": 3 },
      "required_components": ["Growth Monitoring", "Motor/Sensory Milestone", "Physical Exam", "Immunization Reconciliation"]
    },
    {
      "milestone_id": "WC-04M",
      "name": "4-Month Well-Child Visit",
      "target_window": { "target_age_months": 4, "min_age_months": 3, "max_age_months": 5 },
      "required_components": ["Growth Monitoring", "Social/Emotional Milestone", "Physical Exam"]
    },
    {
      "milestone_id": "WC-06M",
      "name": "6-Month Well-Child Visit",
      "target_window": { "target_age_months": 6, "min_age_months": 5, "max_age_months": 8 },
      "required_components": ["Growth Monitoring", "Nutrition Assessment", "Developmental Screen", "Oral Health Introduction"]
    },
    {
      "milestone_id": "WC-09M",
      "name": "9-Month Well-Child Visit",
      "target_window": { "target_age_months": 9, "min_age_months": 8, "max_age_months": 11 },
      "required_components": ["Standardized Developmental Screen (ASQ-3/CDC)", "Growth Monitoring", "Lead/Anemia Risk Assessment"]
    },
    {
      "milestone_id": "WC-12M",
      "name": "12-Month Well-Child Milestone",
      "target_window": { "target_age_months": 12, "min_age_months": 11, "max_age_months": 15 },
      "required_components": ["Anemia Screening (Hemoglobin/CBC)", "Growth Percentiles", "Dental Assessment", "Motor Milestones"]
    },
    {
      "milestone_id": "WC-18M",
      "name": "18-Month Well-Child Visit",
      "target_window": { "target_age_months": 18, "min_age_months": 16, "max_age_months": 21 },
      "required_components": ["Autism Spectrum Screening (M-CHAT-R/F)", "Language Evaluation", "Growth Monitoring"]
    },
    {
      "milestone_id": "WC-24M",
      "name": "24-Month Well-Child Visit",
      "target_window": { "target_age_months": 24, "min_age_months": 22, "max_age_months": 30 },
      "required_components": ["Autism Follow-Up Screen", "BMI Screening", "Speech/Language Check", "Behavioral Development"]
    },
    {
      "milestone_id": "WC-36M",
      "name": "36-Month (3 Years) Well-Child Visit",
      "target_window": { "target_age_months": 36, "min_age_months": 31, "max_age_months": 42 },
      "required_components": ["Vision Screening", "Hearing Screen", "Blood Pressure Baseline", "Social Interaction"]
    },
    {
      "milestone_id": "WC-48M",
      "name": "48-Month (4 Years) Well-Child Visit",
      "target_window": { "target_age_months": 48, "min_age_months": 43, "max_age_months": 54 },
      "required_components": ["School Readiness Assessment", "Vision Screening", "Hearing Screen", "Oral Health"]
    },
    {
      "milestone_id": "WC-60M",
      "name": "60-Month (5 Years) Well-Child Visit",
      "target_window": { "target_age_months": 60, "min_age_months": 55, "max_age_months": 66 },
      "required_components": ["Comprehensive Physical Examination", "Immunization Booster", "Vision Acuity"]
    },
    {
      "milestone_id": "WC-72M",
      "name": "72-Month (6 Years) Transition Visit",
      "target_window": { "target_age_months": 72, "min_age_months": 67, "max_age_months": 78 },
      "required_components": ["School Health Transition Check", "Growth Assessment", "Cardiovascular Vitals Baseline"]
    }
  ]
}
